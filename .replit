modules = ["python-3.12"]
run = "streamlit run app.py --server.port 8080 --server.address 0.0.0.0 --server.headless true"

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "pip install -r requirements.txt"]
run = ["sh", "-c", "streamlit run app.py --server.port 8080 --server.address 0.0.0.0 --server.headless true"]

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 8080 --server.address 0.0.0.0 --server.headless true"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"
