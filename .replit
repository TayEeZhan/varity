modules = ["python-3.12"]
run = "cd backend/signals && python -m trendsignal serve --host 0.0.0.0 --port 8080 --scheduler"

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "pip install -r requirements.txt"]
run = ["sh", "-c", "cd backend/signals && python -m trendsignal serve --host 0.0.0.0 --port 8080 --scheduler"]

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend/signals && python -m trendsignal serve --host 0.0.0.0 --port 8080 --scheduler"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]

[objectStorage]
defaultBucketID = "replit-objstore-1b3ec22c-4e72-48b0-aa90-f55388bea9a9"
