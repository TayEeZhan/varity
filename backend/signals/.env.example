# Copy to .env (read at startup; real environment variables win) or set them as Replit Secrets.
# Every value is optional: without keys the ranker runs on the free sources with the
# deterministic formula, which is the documented fallback.

# Jev (TypeSafe AI System One): decides tier and impact as probabilities.
# Either a TypeSafe key, or on Replit: enable Replit AI Integrations for OpenRouter (Core plan,
# verified phone). Replit then provisions AI_INTEGRATIONS_OPENROUTER_API_KEY and
# AI_INTEGRATIONS_OPENROUTER_BASE_URL itself; the ranker picks them up with model jev-latest.
TYPESAFE_API_KEY=
TRENDSIGNAL_JEV=auto                 # auto | off
TRENDSIGNAL_JEV_MODEL=jev-1.13.0     # pin a version; jev-latest can change rankings silently
TRENDSIGNAL_JEV_TIMEOUT=2.0          # seconds; slower answers fall back to the formula
TRENDSIGNAL_RANKER=formula           # formula | jev. Switch to jev only after it wins on the gold set

# Claude Haiku 5.5: optional category fallback when the rules are unsure (off by default)
# On Replit with no key: enable AI Integrations for Anthropic. It sets AI_INTEGRATIONS_ANTHROPIC_API_KEY
# and _BASE_URL, which are used instead. Its catalogue has no Haiku 5.5 / Sonnet 5.5, so the default
# models become claude-haiku-4-5 (enrich, CV intake) and claude-sonnet-5 (editor). A real key wins.
ANTHROPIC_API_KEY=
TRENDSIGNAL_HAIKU_FALLBACK=0         # 1 = ask Haiku when category confidence < 0.5
TRENDSIGNAL_LLM=auto                 # auto | off
TRENDSIGNAL_LLM_DAILY_BUDGET_USD=2.0
TRENDSIGNAL_ENRICH_MODEL=claude-haiku-5-5

# Optional prose brief (outside the core ranker)
TRENDSIGNAL_BRIEFS=0                 # 1 = also write the daily / weekly brief on schedule
TRENDSIGNAL_EDITOR_MODEL=claude-sonnet-5-5

# Social sources (also set enabled: true for them in config/sources.yaml)
X_BEARER_TOKEN=
THREADS_ACCESS_TOKEN=

# Daily brief delivery (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web app
ADMIN_TOKEN=                         # enables POST /api/admin/run and /api/admin/digest/{kind}
TRENDSIGNAL_SCHEDULER=0              # 1 = run the schedule inside the web process
TRENDSIGNAL_TZ=Asia/Kuala_Lumpur
TRENDSIGNAL_DB=data/trendsignal.db
